{
  "name": "rigby-medusa-lab",
  "private": false,
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "build": "pnpm -r run build",
    "start": "pnpm run build && pnpm -r --parallel run start",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm --dir apps/storefront run typecheck",
    "test": "pnpm --dir apps/backend run test:unit",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "backend:dev": "pnpm --dir apps/backend run dev",
    "storefront:dev": "pnpm --dir apps/storefront run dev",
    "harness:check": "node scripts/check-harness.mjs",
    "harness:smoke": "node scripts/smoke-harness.mjs"
  },
  "devDependencies": {
    "@medusajs/eslint-plugin": "2.21.2",
    "eslint": "^9.39.4",
    "jiti": "^2.7.0",
    "prettier": "^3.2.5",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "turbo": "^2.0.14"
  }
}
